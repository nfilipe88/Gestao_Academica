# Copie este ficheiro para ".env" e preencha com os valores reais.
# NUNCA faça commit do ".env" real (já está no .gitignore).

# Três roles Postgres distintos, por causa do Row-Level Security
# (ver app/database/session.py):
#   app_tenant   — sem BYPASSRLS, usado em todos os pedidos normais.
#   app_sistema  — com BYPASSRLS (mas sem superuser), só para login/
#                  registo/webhooks/Super Admin/jobs cross-tenant.
#   postgres     — superuser, só para correr migrações (alembic).
# Ver back_end/scripts/criar_roles_rls.sql para os criar.
DATABASE_URL=postgresql+asyncpg://app_tenant:senha@localhost:5432/academic_db
DATABASE_URL_SISTEMA=postgresql+asyncpg://app_sistema:senha@localhost:5432/academic_db
DATABASE_URL_MIGRACOES=postgresql+asyncpg://postgres:senha@localhost:5432/academic_db
JWT_SECRET_KEY=defina-aqui-uma-chave-secreta-longa-e-aleatoria

# Base do front-end Angular — usada para montar o link de redefinição
# de palavra-passe enviado por e-mail (ex.: {FRONTEND_URL}/redefinir-senha?token=...).
# Por omissão aponta para o dev server local; mudar em produção.
FRONTEND_URL=http://localhost:4200

# Origens (front-ends) autorizadas a chamar esta API — separadas por
# vírgula (ex.: https://app.escola.pt,https://staging.escola.pt). Sem
# esta variável, assume-se só o dev server local do Angular — NUNCA
# deixar cair nesse default em produção, ou o front-end real fica
# bloqueado pelo CORS.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Redis — opcional, mas passa a ser preciso assim que houver mais de
# uma instância do back-end no ar (load balancer, múltiplos workers em
# máquinas diferentes): coordena o limitador de tentativas de login
# entre instâncias (app/core/rate_limiter.py), impede o scheduler de
# duplicar jobs diários quando corre em mais do que uma instância ao
# mesmo tempo (app/core/lock_distribuido.py), e dá à fila de
# notificações (e-mail/SMS) retries automáticos com backoff em caso de
# falha (app/core/fila_notificacoes.py). Em branco = cada instância
# conta/agenda/envia sozinha e sem retries, só correto com UMA
# instância só.
REDIS_URL=

# Armazenamento de ficheiros (logótipo da escola, anexos de
# Comunicados) — S3-compatível: funciona com AWS S3 (deixe
# S3_ENDPOINT_URL em branco) ou qualquer storage compatível como MinIO
# (ex.: S3_ENDPOINT_URL=http://localhost:9000, ver docker-compose.yml).
# Em branco = ficheiros guardados em disco local (UPLOAD_DIR), só
# correto com UMA instância do back-end (cada instância teria o seu
# próprio disco) — ver app/core/storage.py.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
UPLOAD_DIR=./uploads

# SMS/WhatsApp transacional (lembretes de cobrança) — opcional. Sem
# fornecedor à parte nesta instalação: SMS_WEBHOOK_URL é um endpoint
# HTTPS genérico ({"para", "mensagem"}, Bearer token) que qualquer
# gateway (Twilio, africa's talking, um gateway local angolano, etc.)
# pode expor ou ser colocado atrás de. Em branco = SMS não é enviado
# (fica só registado nos logs) — ver app/core/sms.py.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Sentry (sentry.io -> Settings -> Projects -> a sua App -> Client Keys)
# — opcional. Em branco, os erros continuam só nos logs locais.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# E-mail transacional (boas-vindas, notificação de responsável vinculado, ...).
# Sem estas variáveis o envio é ignorado (fica só registado nos logs) — a
# aplicação continua a funcionar normalmente, os e-mails é que não saem.
# Funciona com qualquer SMTP padrão (Gmail, SendGrid, Mailtrap, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SaaS Gestão Académica
SMTP_USE_TLS=true

# PayPal Developer (developer.paypal.com -> Apps & Credentials -> a sua App)
# PAYPAL_MODE=sandbox enquanto testamos; mudar para "live" só com credenciais de produção.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Opcional, mas recomendado: id do Webhook criado na App (Add Webhook).
# Sem isto, o endpoint de webhook não confirma pagamentos automaticamente
# (a confirmação via "capturar" continua a funcionar sem o webhook).
PAYPAL_WEBHOOK_ID=

# Anthropic (console.anthropic.com -> API Keys) — usada pelo Prof.
# Virtual (app/core/prof_virtual.py). Sem isto, o botão de ajuda do
# aluno devolve 503 ("ainda não está configurado nesta instituição").
ANTHROPIC_API_KEY=
# Opcional — modelo a usar; por omissão claude-sonnet-5.
PROF_VIRTUAL_MODELO=claude-sonnet-5
