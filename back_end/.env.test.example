# Copie para ".env.test" para correr a suite de testes localmente.
# Aponta para uma base de dados SEPARADA da de desenvolvimento
# (academic_db_test, não academic_db) — os testes criam e apagam
# tenants/utilizadores reais a cada execução, nunca deve apontar para
# dados que interessa manter.
#
# Os roles app_tenant/app_sistema já existem no Postgres (são roles de
# login, não são por base de dados — ver scripts/criar_roles_rls.sql).
# Só falta a base de dados em si e os grants nela — feito uma vez por
# scripts/criar_db_teste.py.

DATABASE_URL=postgresql+asyncpg://app_tenant:TROCAR_ESTA_PASSWORD@localhost:5432/academic_db_test
DATABASE_URL_SISTEMA=postgresql+asyncpg://app_sistema:TROCAR_ESTA_OUTRA_PASSWORD@localhost:5432/academic_db_test
DATABASE_URL_MIGRACOES=postgresql+asyncpg://postgres:senha@localhost:5432/academic_db_test

JWT_SECRET_KEY=chave-secreta-so-para-testes-nunca-usar-em-producao

# Deixados em branco de propósito — os testes de pagamento/e-mail/IA que
# precisassem disto são marcados com @pytest.mark.skip até haver
# credenciais de sandbox dedicadas a CI (ver plano de testes no README).
SMTP_HOST=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
ANTHROPIC_API_KEY=
