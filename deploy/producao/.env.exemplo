# Copiar para ".env" nesta pasta (deploy/producao) e preencher.
#   cp .env.exemplo .env && chmod 600 .env
# NUNCA fazer commit do .env (já está no .gitignore).
#
# Passwords e chaves: gerar valores novos e aleatórios para cada um, ex.:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
# (só letras e números — vão dentro de URLs de ligação, não usar símbolos)

# ---- Domínio e certificado ----
DOMINIO=plataforma.exemplo.ao
# E-mail para avisos do Let's Encrypt (certificado a expirar, etc.)
EMAIL_CERTIFICADO=

# ---- Base de dados (Postgres no próprio servidor) ----
POSTGRES_PASSWORD=
APP_TENANT_DB_PASSWORD=
APP_SISTEMA_DB_PASSWORD=
# Ligações por processo: (DB_POOL_SIZE + DB_POOL_MAX_OVERFLOW) × UVICORN_WORKERS
# tem de caber nas 100 do Postgres, com folga para backups/migrações.
UVICORN_WORKERS=2
DB_POOL_SIZE=15
DB_POOL_MAX_OVERFLOW=15
DB_POOL_PREAQUECER=10

# ---- Redis ----
REDIS_PASSWORD=

# ---- Sessões ----
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# ---- Ficheiros (logótipos, anexos, documentos) — S3 EXTERNO ao servidor ----
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Backups da base de dados — bucket PRÓPRIO, credenciais só de escrita ----
# Retenção por regra de ciclo de vida do bucket (ver README.md, "Backup e Restauro").
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# A chave pública vai para segredos/backup_publica.pem nesta pasta (o
# docker-compose monta-a no container). A PRIVADA nunca vem para o servidor.

# ---- E-mail (obrigatório: ativação de contas, recuperação de palavra-passe,
#      códigos da verificação em dois passos) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Gestão Académica
SMTP_USE_TLS=true

# ---- Recomendados ----
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
SENTRY_DSN=
SENTRY_DSN_FRONTEND=

# ---- Opcionais (ver back_end/.env.example) ----
ANTHROPIC_API_KEY=
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
