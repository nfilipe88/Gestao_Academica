# Modelo de produção do nginx — ${DOMINIO} é substituído no arranque pelo
# valor do .env (envsubst da imagem oficial; as variáveis do próprio nginx,
# como $host, ficam intactas porque não existem no ambiente).
# Cabeçalhos de segurança: os mesmos de deploy/nginx.conf (desenvolvimento,
# ver os comentários lá), mais HSTS, agora que há HTTPS.

server_tokens off;

# HTTP: só serve a validação do Let's Encrypt; tudo o resto vai para HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMINIO};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Qualquer outro nome (ex.: acesso direto pelo IP do servidor): fecha a ligação.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    return 444;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMINIO};

    ssl_certificate /etc/letsencrypt/live/${DOMINIO}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMINIO}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 10m;

    # HSTS: durante 1 ano o browser recusa HTTP simples para este domínio.
    # Sem includeSubDomains: outros subdomínios podem ainda não ter HTTPS.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://www.google.com/recaptcha/; frame-src 'self' blob: https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; object-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=()" always;

    # Endereços de ferramentas de varrimento (ficheiros de configuração,
    # painéis de outros sistemas): vão para o back-end, que os regista
    # como evento de segurança com o IP real e responde 404 — sem isto
    # iam para o front-end e ninguém sabia. Ver app/core/eventos_seguranca.py.
    location ~* (/\.env|/\.git|/\.svn|/\.aws|/\.ssh|/\.htaccess|wp-admin|wp-login|wp-content|xmlrpc\.php|phpmyadmin|\.php$|\.aspx?$|\.jsp$|cgi-bin|/actuator|/server-status|/vendor/phpunit|/boaform|/HNAP1|/manager/html) {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Substitui (não acrescenta) o que o cliente mandou — ver deploy/nginx.conf.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        # O back-end também envia HSTS em HTTPS (app/core/cabecalhos.py);
        # aqui fica só o do nginx, sem cabeçalho duplicado.
        proxy_hide_header Strict-Transport-Security;
    }

    location / {
        proxy_pass http://frontend:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# HTTPS para outros nomes: recusa o handshake em vez de mostrar o certificado do domínio.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
}
